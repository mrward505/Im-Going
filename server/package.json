{
  "name": "@imgoing/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "I'm Going API — REST over Postgres (MVP slice 1)",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "migrate": "bun src/db/migrate.ts up",
    "migrate:status": "bun src/db/migrate.ts status",
    "seed": "bun seed/seed.ts",
    "seed:check": "bun seed/seed.ts --check"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}