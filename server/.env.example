# I'm Going API — environment template.
# Copy to server/.env and fill in. NEVER commit .env (it is git-ignored).
# Production values must come from a real secret store, not this file.

# ---- Postgres (see ../scripts/dev-db.sh for the local dev database) ----
DATABASE_URL=postgres://imgoing:CHANGE_ME@127.0.0.1:5432/imgoing

# ---- HTTP server ----
PORT=8081   # 8080 is reserved on the team dev box by an unrelated local service
HOST=127.0.0.1
LOG_LEVEL=info

# ---- SMS OTP ----
# console = dev: the code is printed to the server log (no real SMS sent)
# twilio  = real SMS (requires the TWILIO_* vars below; wired in a later slice)
OTP_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---- Auth ----
# PRODUCTION MUST be a long random string (e.g. `openssl rand -hex 32`)
AUTH_JWT_SECRET=CHANGE_ME_to_a_long_random_string_64_chars
SESSION_TTL_DAYS=30
SIGNUP_TOKEN_TTL_MINUTES=15

# ---- Object storage (placeholders — upload endpoints are later slices) ----
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_LOCAL_DIR=./data/uploads

# ---- MVP single city ----
LAUNCH_CITY=Tempe